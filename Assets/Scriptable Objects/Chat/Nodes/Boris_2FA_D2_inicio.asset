  nodeId: inicio
  npcMessage: "Amigo, d\xFAvida b\xE1sica: pra que serve o 2FA? Se algu\xE9m descobrir
    minha senha, eu posso s\xF3 trocar depois, n\xE9?"
  typingDelay: 1.5
  options:
  - optionText: O 2FA exige uma segunda prova de identidade, reduzindo o risco se
      a senha for descoberta. Se vazar, avise a TI e troque-a imediatamente.
    nextNodeId: tecnico
    outcome: 0
    outcomeFeedback: 
    securityScoreDelta: 0
    feedbackTag: boris_2fa_tecnico
    emailTriggerId: 
    emailDelay: 3
  - optionText: "\xC9 como uma segunda fechadura: saber a senha n\xE3o basta. E,
      se ela vazar, a gente conta pra TI e troca logo."
    nextNodeId: didatico
    outcome: 0
    outcomeFeedback: 
    securityScoreDelta: 0
    feedbackTag: boris_2fa_didatico
    emailTriggerId: 
    emailDelay: 3
  - optionText: "O c\xF3digo extra \xE9 o seguran\xE7a da porta. N\xE3o deixa pra
      trocar depois: senha suspeita? TI e troca imediata!"
    nextNodeId: pratico
    outcome: 0
