  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O e-mail tem duas abas:\n- <b>Empresa:</b> e-mails que precisam da sua
    decis\xE3o.\n- <b>Usu\xE1rio:</b> e-mails s\xF3 para voc\xEA (orienta\xE7\xF5es,
    respostas). N\xE3o precisam de decis\xE3o.\n\nAo abrir um e-mail voc\xEA v\xEA
    o remetente, o assunto, o corpo e os anexos. Clique no nome de um anexo para
    abri-lo."
  m_isRightToLeft: 0
