  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Colegas (e golpistas fingindo ser colegas) tamb\xE9m falam com voc\xEA
    pelo chat. Algumas respostas contam como acerto ou erro, igual aos e-mails.\n\nNunca
    passe sua senha ou c\xF3digos de acesso pelo chat, nem para quem diz ser do suporte.
    Algumas conversas precisam ser respondidas antes de terminar o dia."
  m_isRightToLeft: 0
